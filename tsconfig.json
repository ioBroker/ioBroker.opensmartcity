// Root tsconfig: type checking and editor support for the backend (src/) and the build script (tasks.ts).
// It never emits - the compilation of the backend is configured in tsconfig.build.json.
// The admin (src-admin/) and the widgets (src-widgets/) have their own tsconfig.json.
{
    "compileOnSave": true,
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "allowJs": false,
        "skipLibCheck": true,
        "noEmitOnError": true,
        "outDir": "./build/",
        "removeComments": false,
        "module": "Node16",
        "moduleResolution": "node16",
        "resolveJsonModule": true,
        "strict": true,
        "strictNullChecks": true,
        "strictPropertyInitialization": true,
        "target": "es2022",
        "sourceMap": true,
        "inlineSourceMap": false,
        "useUnknownInCatchVariables": false,
        "types": ["@iobroker/types", "@types/node"]
    },
    "include": ["src/**/*.ts", "tasks.ts"],
    "exclude": ["build/**", "node_modules/**", "admin/**", "widgets/**", "src-admin/**", "src-widgets/**", "test/**"]
}
