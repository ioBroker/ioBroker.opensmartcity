{
  "name": "iobroker.opensmartcity",
  "version": "0.2.2",
  "description": "ioBroker opensmartcity Adapter",
  "author": {
    "name": "ioBroker Community Developers",
    "email": "info@iobroker.net"
  },
  "engines": {
    "node": ">=22"
  },
  "contributors": [
    {
      "name": "ioBroker Community Developers",
      "email": "info@iobroker.net"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.opensmartcity",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "opensmartcity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.opensmartcity.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@iobroker/vis-2-widgets-react-dev": "^1.0.5",
    "@iobroker/vis-2-widgets-testing": "^1.0.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "gulp": "^4.0.2",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.opensmartcity/issues"
  },
  "readmeFilename": "README.md",
  "main": "main.js",
  "files": [
    "admin/",
    "widgets/",
    "main.js",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test:package": "mocha test/package.js --exit",
    "test:integration": "mocha test/integration.js --exit",
    "test:widgets": "mocha ./test/widgets.test.js --exit",
    "test": "npm run test:package",
    "lint": "eslint -c eslint.config.mjs",
    "build": "gulp",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "ncu --upgrade && cd src-admin && ncu --upgrade && cd .. && cd src-widgets && ncu --upgrade",
    "npm": "npm i && cd src-admin && npm i -f && cd ../src-widgets && npm i -f && cd .."
  }
}
