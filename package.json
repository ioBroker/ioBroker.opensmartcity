{
  "name": "iobroker.opensmartcity",
  "version": "0.4.1",
  "description": "ioBroker opensmartcity Adapter",
  "author": {
    "name": "ioBroker Community Developers",
    "email": "info@iobroker.net"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "contributors": [
    {
      "name": "ioBroker Community Developers",
      "email": "info@iobroker.net"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.opensmartcity",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "opensmartcity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ioBroker/ioBroker.opensmartcity.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.21.0",
    "iobroker.opensmartcity": "file:"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@iobroker/vis-2-widgets-testing": "^2.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.opensmartcity/issues"
  },
  "readmeFilename": "README.md",
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx tasks.ts",
    "build-backend": "tsc -p tsconfig.build.json",
    "build-admin": "tsx tasks.ts --admin-build",
    "build-widgets": "tsx tasks.ts --widget-build",
    "build-wc": "tsx tasks.ts --wc-build",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "check-admin": "cd src-admin && npm run check-ts",
    "check-wc": "cd src-webcomponents && npm run check-ts",
    "lint": "eslint -c eslint.config.mjs",
    "lint-admin": "cd src-admin && npm run lint",
    "lint-wc": "cd src-webcomponents && npm run lint",
    "0-clean": "tsx tasks.ts --0-clean",
    "1-npm": "tsx tasks.ts --1-npm",
    "2-build": "tsx tasks.ts --2-build",
    "3-copy": "tsx tasks.ts --3-copy",
    "4-patch": "tsx tasks.ts --4-patch",
    "0-widget-clean": "tsx tasks.ts --0-widget-clean",
    "1-widget-npm": "tsx tasks.ts --1-widget-npm",
    "2-widget-build": "tsx tasks.ts --2-widget-build",
    "3-widget-copy": "tsx tasks.ts --3-widget-copy",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "mocha test/integration.js --exit",
    "test:widgets": "mocha ./test/widgets.test.js --exit",
    "test": "npm run test:package",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade && cd .. && cd src-widgets && npx -y npm-check-updates --upgrade && cd ../src-webcomponents && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i -f && cd ../src-widgets && npm i -f && cd ../src-webcomponents && npm i && cd .."
  }
}
